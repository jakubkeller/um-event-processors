<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UM.Infra.EventProcessors</AssemblyName>
    <RootNamespace>UM.Infra.EventProcessors</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="infraconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="infraconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.149.0" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.300.119" />
    <PackageReference Include="Cdklabs.CdkMonitoringConstructs" Version="8.0.0" />
    <PackageReference Include="Constructs" Version="10.3.0" />
    <PackageReference Include="UM.Infra.Base" Version="2.0.*" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="3.7.304.14" />
    <PackageReference Include="AWSSDK.SSO" Version="3.7.300.95" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="3.7.302.6" />
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
  </ItemGroup>

</Project>
