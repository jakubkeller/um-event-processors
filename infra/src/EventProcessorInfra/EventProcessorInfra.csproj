<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UM.Infra.EventProcessors</AssemblyName>
    <RootNamespace>UM.Infra.EventProcessors</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="infraconfig.json" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="infraconfig.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.269.0" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="4.0.101" />
    <PackageReference Include="Cdklabs.CdkMonitoringConstructs" Version="8.0.0" />
    <PackageReference Include="Constructs" Version="10.5.0" />
    <PackageReference Include="UM.Infra.Base" Version="4.0.*" />
    <PackageReference Include="AWSSDK.SimpleSystemsManagement" Version="4.0.103.9" />
    <PackageReference Include="AWSSDK.SSO" Version="4.0.100.16" />
    <PackageReference Include="AWSSDK.SSOOIDC" Version="4.0.100.15" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
  </ItemGroup>

</Project>
